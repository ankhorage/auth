                        "type": "string"
                      },
                      "user": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          },
                          "phone": {
                            "type": "string"
                          },
                          "username": {
                            "type": "string"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "avatarUrl": {
                            "type": "string"
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": {}
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "ok",
                  "status",
                  "provider",
                  "reason"
                ],
                "properties": {
                  "ok": {
                    "const": false
                  },
                  "status": {
                    "const": "cancelled"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "user_cancelled",
                      "browser_dismissed",
                      "provider_denied"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "ok",
                  "status",
                  "error"
                ],
                "properties": {
                  "ok": {
                    "const": false
                  },
                  "status": {
                    "const": "error"
                  },
                  "error": {
                    "type": "object",
                    "required": [
                      "code",
                      "message",
                      "stage",
                      "recoverable"
                    ],
                    "properties": {
                      "code": {
                        "type": "string",
                        "enum": [
                          "oauth_unavailable",
                          "provider_disabled",
                          "provider_misconfigured",
                          "invalid_redirect_uri",
                          "authorization_failed",
                          "authorization_attempt_not_found",
                          "invalid_callback",
                          "state_mismatch",
                          "pkce_mismatch",
                          "callback_already_completed",
                          "code_exchange_failed",
                          "network_error",
                          "session_persistence_failed",
                          "profile_creation_failed",
                          "provider_error"
                        ]
                      },
                      "message": {
                        "type": "string"
                      },
                      "cause": {},
                      "stage": {
                        "type": "string",
                        "enum": [
                          "start",
                          "transport",
                          "callback",
                          "exchange",
                          "session",
                          "profile"
                        ]
                      },
                      "provider": {
                        "type": "string"
                      },
                      "recoverable": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    ]
  },
